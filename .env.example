# =============================================================================
# CrewAI PR Review Workflow - Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# Choose from pre-configured providers or use custom endpoints.
# Run 'pr-review providers' to see all available options.

# Reviewer Model (for code review tasks - reasoning heavy)
# Options: deepseek-reasoner, deepseek-chat, gpt-4o, claude-sonnet, llama-3.3-70b
REVIEWER_MODEL=deepseek-reasoner
REVIEWER_API_KEY=your_api_key_here
REVIEWER_BASE_URL=https://api.deepseek.com

# Implementer Model (for fix generation - code heavy)
# Options: gpt-4o-mini, claude-haiku, qwen2.5-coder (local)
IMPLEMENTER_MODEL=gpt-4o-mini
IMPLEMENTER_API_KEY=your_openai_key_here
IMPLEMENTER_BASE_URL=

# Fast Model (for triage and summaries - speed focused)
# Options: gpt-4o-mini, llama-3.1-8b, claude-haiku
FAST_MODEL=gpt-4o-mini
FAST_API_KEY=your_api_key_here
FAST_BASE_URL=

# -----------------------------------------------------------------------------
# Provider-Specific API Keys (if using multiple providers)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GROQ_API_KEY=gsk_xxx

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------
# Required for PR access and posting comments
GITHUB_TOKEN=your_github_token_here

# -----------------------------------------------------------------------------
# Workflow Settings
# -----------------------------------------------------------------------------
# Maximum lines of code per review batch (larger PRs are split)
MAX_LOC_PER_BATCH=2000

# Output directory for review artifacts
OUT_DIR=out

# Post incremental comments after each review task
INCREMENTAL_COMMENTS=false

# Post a summary comment at the end
POST_SUMMARY_COMMENT=true

# Skip documentation files (.md, .mdx)
SKIP_DOC_REVIEWS=true

# Number of review agents to run (1=perf, 2=perf+security, 3=+coverage)
MAX_REVIEW_AGENTS=3

# Skip fix generation, only run reviews
REVIEW_ONLY=false

# Write comment payloads without posting to GitHub
DRY_RUN_COMMENTS=false

# -----------------------------------------------------------------------------
# Performance Optimization
# -----------------------------------------------------------------------------
# Enable result caching to avoid redundant API calls
ENABLE_CACHE=true

# Cache time-to-live in seconds (default: 1 hour)
CACHE_TTL=3600

# Cache directory
CACHE_DIR=.cache/pr_review

# Maximum patch size (lines) to send to models
MAX_PATCH_SIZE=500

# Skip reviewing test files
SKIP_TEST_REVIEWS=true

# -----------------------------------------------------------------------------
# Ollama Settings (for local models)
# -----------------------------------------------------------------------------
# Limit CPU threads (reduce for lower CPU usage)
OLLAMA_NUM_THREADS=4

# GPU layers (0 = CPU only, increase if you have GPU)
OLLAMA_NUM_GPU=0

# Context window size (smaller = faster)
OLLAMA_CONTEXT_SIZE=2048

# -----------------------------------------------------------------------------
# Optional: CI Hooks
# -----------------------------------------------------------------------------
# Commands to run after review (e.g., run tests)
TEST_CMD=
COVERAGE_CMD=
